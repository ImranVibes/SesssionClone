{
  "manifest_version": 3,
  "name": "SessionClone - Manage Cookies & Local Storage",
  "version": "1.0.0",
  "description": "Clone your login session between browsers in one click. Copy & paste cookies and site storage - no re-login.",
  "permissions": [
    "cookies",
    "storage",
    "scripting"
  ],
  "optional_permissions": [
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SessionClone - Manage Cookies & Local Storage",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "102"
}
